# Copy to `.env` and adjust. All dashboard vars are build-time (VITE_*) and can
# also be overridden at runtime from the in-app Settings page.

# bunqueue server origin. In dev, leave unset — requests to `/api/*` are proxied
# to http://localhost:6790 by Vite. In prod (Docker / Pages), set the reachable
# server origin, e.g. https://queue.example.com
# VITE_BUNQUEUE_URL=

# Never put bearer tokens in VITE_* variables: they are compiled as plaintext
# into the public JS bundle. Enter server/agent tokens in the in-app prompt for
# the current browser session, or enforce authentication at a reverse proxy.

# Control-agent origin (start/stop/restart). Defaults to http://localhost:6800.
# VITE_BUNQUEUE_AGENT_URL=

# ---- All-in-one server + control agent -------------------------------------
# Dashboard listener. Keep loopback behind a same-host proxy; use 0.0.0.0 only
# for direct LAN/container access and configure the Host allowlist below.
# BIND_ADDR=127.0.0.1
# PORT=8080
# Runtime mount for reverse-proxy subpath hosting. No trailing slash required.
# BASE_PATH=/internal/queue
# BUNQUEUE_URL=http://localhost:6790
# Set to 0 when systemd, Docker or Kubernetes owns the Bunqueue process. The
# Server page then probes BUNQUEUE_URL and disables lifecycle/config mutations
# plus stopped-only backup restore, which cannot be proven safe externally.
# BUNQUEUE_MANAGED=0
# AGENT_PORT=6800
# Extra browser origins allowed to drive the agent (comma-separated).
# AGENT_ALLOWED_ORIGINS=
# Extra raw Host header names/IPs admitted on all routes. Required for wildcard
# binds and for a proxy-preserved or rewritten non-loopback Host.
# AGENT_ALLOWED_HOSTS=
# Local access: optional mutation token. LAN/proxied bridge: mandatory token on
# every /agent route, including status, logs, config and database reads.
# AGENT_TOKEN=
# LAN/proxied all-in-one access: mandatory bearer on every /api route. Enter the
# same value as the Server token in Settings; if Bunqueue uses AUTH_TOKENS, this
# value must be one of those tokens because Authorization is forwarded upstream.
# BUNQUEUE_TOKEN=
# Set only when a trusted proxy overwrites X-Forwarded-Host while rewriting Host.
# TRUST_PROXY=1
